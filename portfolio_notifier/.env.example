# Groww Credentials
GROWW_EMAIL=your_email@example.com
GROWW_PASSWORD=your_password
GROWW_PIN=your_pin

# Mobile Number for Notifications
MOBILE_NUMBER=+919876543210

# SMS Provider (twilio, msg91, fast2sms)
SMS_PROVIDER=twilio

# Twilio Credentials (if using Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Credentials (if using MSG91)
MSG91_AUTH_KEY=your_auth_key
MSG91_SENDER_ID=your_sender_id
MSG91_ROUTE=4

# Fast2SMS Credentials (if using Fast2SMS)
FAST2SMS_API_KEY=your_api_key
